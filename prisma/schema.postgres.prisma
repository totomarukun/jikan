// 本番 (Vercel + PostgreSQL/Supabase) 用スキーマ。
// モデル定義は prisma/schema.prisma (SQLite/ローカル用) と完全に同一に保つこと。
// デプロイ時は package.json の build:deploy がこのスキーマで
// generate / db push を実行する (vercel.json 参照)。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase 等で接続プーラー (pgbouncer) を使う場合は 5432 直結URLを設定。
  // プーラーを使わない場合は DATABASE_URL と同じ値でよい。
  directUrl = env("DIRECT_URL")
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  nickname          String?
  // scrypt ハッシュ "salt:hex"。旧アカウント(パスワード未設定)は null
  passwordHash      String?
  // この ユーザーのデータ本体が紐づくセッション (ログイン時にcookieへ復元)
  primarySessionId  String?
  // enum: DRIVE | QUICK_ATTACK | CUT | OTHER | UNDECIDED
  playstyle         String       @default("UNDECIDED")
  // enum: BEGINNER | INTERMEDIATE | ADVANCED | NON_PLAYER
  level             String       @default("INTERMEDIATE")
  // enum: OUTER_CARBON | INNER_CARBON | WOOD | STICKY | UNKNOWN
  bladeCategory     String       @default("UNKNOWN")
  // enum: SHAKEHAND | PENHOLD_CN | PENHOLD_JP
  grip              String       @default("SHAKEHAND")
  currentBladeId    String?
  currentFhRubberId String?
  currentBhRubberId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  comparisons       Comparison[]
}

model Equipment {
  id               String       @id @default(cuid())
  // enum: RUBBER_INVERTED | RUBBER_PIMPLE_OUT | RUBBER_PIMPLE_LONG |
  //       RUBBER_ANTI | RUBBER_STICKY | BLADE
  category         String
  manufacturer     String
  name             String
  price            Int?
  officialSpeed    Int?
  officialSpin     Int?
  officialArc      Int?
  hardness         Int?
  // enum (ラケットのみ): OUTER_CARBON | INNER_CARBON | WOOD
  bladeSubcategory String?
  imageUrl         String?
  isActive         Boolean      @default(true)
  // ユーザー投稿で追加された製品 (企画書 12.4 UGC補完。後から確認・整備する)
  isUserSubmitted  Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  comparisonsAsA   Comparison[] @relation("OptionA")
  comparisonsAsB   Comparison[] @relation("OptionB")
  gearEntries      GearItem[]   @relation("GearEquipment")
  gearAsBlade      GearItem[]   @relation("GearBlade")

  @@unique([manufacturer, name])
  @@index([category, isActive])
}

// マイギア: ユーザーが過去〜現在に使った用具 (使用条件つき)。
// 出題はここから生成する。「両方使った人の相対判定」だけが信頼できるため。
model GearItem {
  id               String     @id @default(cuid())
  sessionId        String
  userId           String?
  equipmentId      String
  equipment        Equipment  @relation("GearEquipment", fields: [equipmentId], references: [id])
  // enum: FH | BH (ラバーの貼り面)
  side             String     @default("FH")
  // enum: TOKUATSU | ATSU | CHU | USU | UNKNOWN (スポンジ厚)
  thickness        String     @default("UNKNOWN")
  // 当時使っていたラケット (任意)
  bladeEquipmentId String?
  blade            Equipment? @relation("GearBlade", fields: [bladeEquipmentId], references: [id])
  // いま使っているか
  isCurrent        Boolean    @default(false)
  // このラバーを貼った日 (張り替え時期リマインドの起点。createdAt とは別概念)
  usageStartedAt   DateTime?
  // 乗り換え理由・感想などの自由メモ (遍歴の質的記録)
  note             String?
  createdAt        DateTime   @default(now())

  @@index([sessionId])
  @@index([userId])
}

// 1回のAB比較回答
model Comparison {
  id                   String    @id @default(cuid())
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id])
  sessionId            String
  // enum: rubber | blade
  category             String
  optionAEquipmentId   String
  optionA              Equipment @relation("OptionA", fields: [optionAEquipmentId], references: [id])
  optionBEquipmentId   String
  optionB              Equipment @relation("OptionB", fields: [optionBEquipmentId], references: [id])
  contextPlaystyle     String
  contextLevel         String
  contextBladeCategory String
  contextGrip          String    @default("SHAKEHAND")
  // enum: A | B | SAME | UNKNOWN
  winnerOverall        String?
  winnerSpeed          String?
  winnerSpin           String?
  winnerControl        String?
  winnerHardness       String?
  winnerBallHold       String?
  // 弧線の高さ (高い=山なり / 低い=直線的)
  winnerArc            String?
  // 粘着の強さ (粘着系ラバー同士のときのみ)
  winnerTackiness      String?
  // 攻撃(ドライブ・スマッシュ)のしやすさ
  winnerAttackEase     String?
  // 守備(ツッツキ・ブロック)のしやすさ
  winnerDefenseEase    String?
  // 体感のひとこと (両方使った人の言葉。定性レビューの最小単位)
  comment              String?
  // enum: BOTH | ONE | NEITHER (マイギアから自動判定)
  hasActualExperience  String?
  // 回答時に参照したギア (使用条件の追跡用)
  optionAGearItemId    String?
  optionBGearItemId    String?
  answeredAt           DateTime  @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([optionAEquipmentId, optionBEquipmentId])
}

// 匿名セッションの進捗管理
model SessionProgress {
  sessionId          String   @id
  playstyle          String   @default("UNDECIDED")
  level              String   @default("INTERMEDIATE")
  bladeCategory      String   @default("UNKNOWN")
  grip               String   @default("SHAKEHAND")
  // いま使っているフォア面ラバー (任意)。出題・乗り換え検討の基準点になる
  currentRubberId    String?
  answerCount        Int      @default(0)
  // JSON 文字列の配列 例: "[5,10]"
  unlockedMilestones String   @default("[]")
  // 30問達成時に確定したスタイル名 (該当率の母集団計算に使用)
  diagnosedStyle     String?
  firstAnswerAt      DateTime @default(now())
  lastAnswerAt       DateTime @updatedAt
}
